# Munki Manager Configuration
# Copy this to .env and fill in your values

# Database
# Local: postgresql+asyncpg://automunki:automunki@localhost:5432/automunki
# Neon:  postgresql+asyncpg://user:pass@ep-xxx-yyy-123456.us-east-2.aws.neon.tech/automunki?sslmode=require
DATABASE_URL=postgresql+asyncpg://automunki:automunki@localhost:5432/automunki

# Security - CHANGE THIS IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# How long an issued JWT remains valid (seconds).
# Defaults to 28800 (8 hours / one workday). There's no refresh-token flow yet,
# so the SPA bounces users to /login when this expires. Bump higher
# (86400 = 24h, 604800 = 7d) for longer-lived sessions; the trade-off is the
# blast radius of a stolen token. Rotating SECRET_KEY invalidates ALL outstanding
# tokens immediately.
# JWT_LIFETIME_SECONDS=28800

# Debug mode
DEBUG=false

# Auth: disabled | jwt | oidc (backend). Use jwt or oidc in production.
AUTH_MODE=disabled
# Set false to block POST /auth/register
AUTH_REGISTRATION_OPEN=true
# The SPA reads auth mode from GET /api/v1/auth/config at runtime.

# OIDC (when AUTH_MODE=oidc)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
# OIDC_REDIRECT_URL=http://localhost:3000/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://your-idp.example.com
# PUBLIC_APP_URL=http://localhost:3000

# GitHub Integration
# Used for two things:
#   1. Dispatching the AutoPkg cloud-runner workflow on GITHUB_REPO.
#   2. Reading recipe contents from autopkg/* (and other authors' repos)
#      for trust verification.
# Simplest token that covers both: classic PAT with `public_repo` + `workflow`
# (or `repo` + `workflow` if GITHUB_REPO is private). Fine-grained PATs work
# but the autopkg org rejects ones with lifetime > 366 days, so keep them
# short-lived and grant "Public Repositories: Read-only".
GITHUB_TOKEN=
GITHUB_REPO=your-org/munki-manager
# Branch on GITHUB_REPO that holds .github/workflows/autopkg_cloud_runner.yml
# (defaults to "main"; only override if you keep the workflow on a different branch)
# GITHUB_WORKFLOW_REF=main

# Default AutoPkg runner when the UI does not choose one: github | local
# local = only register the run; execute on a Mac (see docs/local-autopkg-runner.md)
AUTOPKG_RUNNER_MODE=github

# Optional: shared secret for local/poll AutoPkg scripts (Authorization: Bearer).
# Same file is read by run_local_autopkg.sh from the repo .env (no export needed).
# Accepted for claim-next-local, metadata-cache, runs/config, GET run by id, plus
# POST /autopkg/pkginfo/ingest and POST /autopkg/icons/ingest (see docs/local-autopkg-runner.md).
# Generate with: openssl rand -hex 32
LOCAL_RUNNER_TOKEN=

# --- Storage backend for the AutoPkg auto-uploader ---------------------------
# Selects which object store the backend pushes pkgs/icons to after an AutoPkg
# run. With STORAGE_BACKEND=none, packages are served from whatever URL you set
# in MUNKI_REPO_PKG_BASE_URL below (S3+CloudFront, Azure Blob+CDN, Mac mini
# nginx, etc.). See docs/storage-backends.md.
# Values: none | s3 | azure_blob   (default: none)
STORAGE_BACKEND=none

# Example A — AWS S3 + CloudFront
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# CLOUDFRONT_DISTRIBUTION_ID=

# Example B — Azure Blob Storage (+ optional Azure CDN/Front Door)
# Pick one auth path:
#   1) Connection string (simplest):
#      AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
#   2) Account name + SAS token (read-write SAS scoped to the container):
#      AZURE_STORAGE_ACCOUNT_NAME=mymunkirepo
#      AZURE_STORAGE_SAS_TOKEN=sv=2024-...&sig=...
#   3) Managed identity (when the backend runs in Azure):
#      AZURE_STORAGE_ACCOUNT_NAME=mymunkirepo   # leave SAS / connection string empty
# AZURE_STORAGE_CONTAINER=munki-repo
# AZURE_CDN_PROFILE=
# AZURE_CDN_ENDPOINT=

# Notifications
SLACK_WEBHOOK_URL=

# Public URL (used in GitHub Actions workflow dispatch)
# Set this to your ngrok/tunnel URL when testing, e.g. https://xxxx.ngrok-free.app
# This is the single URL for both frontend and API (port 3000)
API_PUBLIC_URL=

# Backend URL (used by the frontend container to proxy /api/* requests)
# Default: http://localhost:8000 — only change if the backend runs on a different host
# BACKEND_URL=http://localhost:8000

# Optional: point the SPA directly at the API instead of using the same-origin proxy.
# Use the API origin only (e.g. http://127.0.0.1:8000). Do not set …/api/v1 or requests become /api/v1/api/v1/… (404).
# VITE_PUBLIC_API_URL=

# CORS (only needed if frontend and backend are on different origins)
# With the proxy, CORS is not required for normal operation
CORS_ORIGINS=["http://localhost:3000"]

# Admin AI Insights (Gemini tool-calling agent; admin-only RBAC page)
# INSIGHTS_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# User profile avatars: stored as bytes in Postgres (user.avatar_data) so
# they survive Container App revision restarts and replicate across replicas.
# No env var needed; the previous USER_AVATARS_DIRECTORY setting has been
# removed.

# Optional: HTTP Basic for /repo (munki clients). When both are set, credentials come from the
# environment and override the database (Settings UI PATCH returns 409). Prefer Settings for DB-backed auth.
# MUNKI_REPO_BASIC_AUTH_USER=
# MUNKI_REPO_BASIC_AUTH_PASSWORD=

# --- External Munki URLs written into enrolled clients' .mobileconfig ---
# These are the URLs Munki clients FETCH FROM. Whatever object store you use
# (S3+CloudFront, Azure Blob+CDN, Mac mini nginx, or anything else over HTTPS)
# must be reachable at these URLs. See docs/storage-backends.md for examples.
#
# When set, these pin the corresponding value and the Settings UI ("Package
# & client resource URLs") cannot override it. Leave unset to manage at
# runtime from the UI.
#
# These are *not* redirects. Munki fetches packages and client_resources
# directly from these URLs, because its downloader drops `Authorization`
# headers on cross-origin 302s (which broke downloads via the app).
#
# Examples:
#   AWS S3 + CloudFront:  https://d111111abcdef8.cloudfront.net/pkgs
#   Azure Blob + CDN:     https://munkimanager.blob.core.windows.net/munki-repo/pkgs
#   Mac mini nginx:       https://munki.example.com/pkgs
#
# MUNKI_REPO_PKG_BASE_URL=
# MUNKI_REPO_CLIENT_RESOURCES_BASE_URL=    # derived from PKG_BASE_URL when unset
#
# Optional: where /repo/icons/* 302-redirects (when you want to host icons
# externally instead of serving them from Postgres)
# MUNKI_REPO_ICON_BASE_URL=
